# Copy to .env and fill in, or set these in your MCP client's "env" block.

# Your Sana domain. Accepts a bare subdomain ("acme"), a host
# ("acme.sana.ai"), or a full URL ("https://acme.sana.ai").
# Aliases: SANA_BASE_URL, SANA_URL
SANA_DOMAIN=acme

# OAuth2 client credentials from Sana: Settings -> API -> create an API client.
# The secret is shown once — store it somewhere safe.
# Aliases: CLIENT_ID, CLIENT_SECRET
SANA_CLIENT_ID=
SANA_CLIENT_SECRET=

# Token scope. Use "read" to deploy read-only; write tools then fail with a
# clear 403 instead of changing anything.
# SANA_SCOPE=read,write

# How long (seconds) the content catalog is cached for sana_search_content.
# Lower it if content changes frequently and search staleness matters.
# SANA_CATALOG_TTL=900

# Wall-clock seconds allowed for a cold catalog fetch. When it runs out, search
# returns what it has and flags the shortfall rather than blocking. Raise it for
# very large catalogs; lower it if your host enforces a short tool-call timeout.
# SANA_CATALOG_BUDGET=15
